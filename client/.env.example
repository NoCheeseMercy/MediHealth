# Copy to .env and fill in.

# URL of the deployed AI proxy (see worker/README.md for the ~10-minute setup).
# This is the ONLY AI config the app needs — the NVIDIA key lives in the
# Worker as a Cloudflare secret, never in the app bundle.
EXPO_PUBLIC_AI_PROXY_URL=

# Only if you configured APP_SHARED_SECRET on the Worker. Note: this value is
# inlined into the app bundle, so it is hardening against drive-by use of your
# worker URL, not true secrecy.
EXPO_PUBLIC_AI_SHARED_SECRET=

# ── Legacy (no longer read by the app) ─────────────────────────
# EXPO_PUBLIC_NIM_API_KEY / EXPO_PUBLIC_NIM_MODEL shipped the NVIDIA key inside
# the APK. If either is still set in your environment or EAS secrets, delete it
# there after migrating to the proxy.
